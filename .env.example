ARC_RPC_URL=https://rpc.arc-scan.org
# Optional, comma-separated, used only after transient primary failures exhaust retries.
ARC_RPC_FALLBACK_URLS=
# Primary budget shared by ALL processes (including retries/chain checks).
ARC_RPC_REQUESTS_PER_SECOND=2
# Optional Alchemy throughput CU budget; 0 disables weighting for public RPCs.
ARC_RPC_COMPUTE_UNITS_PER_SECOND=0
# Separate shared budget for all fallback providers; keep public RPC conservative.
ARC_RPC_FALLBACK_REQUESTS_PER_SECOND=2
ARC_RPC_RATE_LIMIT_FILE=data/rpc_rate_limit.sqlite3
ARC_CHAIN_ID=5042
# Historical analyzer mode: adds a resumable worker; legacy forward promotion is
# preserved but not run by auto_discovery in this mode. No runtime authority added.
HISTORICAL_ANALYSIS_ENABLED=false
HISTORICAL_TRANSACTIONS_PER_STEP=10
# Concurrent historical transaction/receipt/block reads; same shared RPC budget.
# Keep 1 on a public RPC; try 8 with a dedicated paid provider (maximum 16).
HISTORICAL_RPC_WORKERS=1
# Dedicated history pause; does not change discovery/Arcscan polling settings.
HISTORICAL_POLL_SECONDS=60
# Shorter pause only after a successful active cycle; idle/error cycles keep the above delay.
HISTORICAL_ACTIVE_POLL_SECONDS=5
HISTORICAL_REFRESH_SECONDS=21600
# Collection order only; no qualification/scoring changes. 3 focused slots / 1 fair slot.
HISTORICAL_PRIORITY_ENABLED=true
HISTORICAL_FOCUS_STEPS=4
HISTORICAL_INACTIVE_DAYS=3
HISTORICAL_INACTIVE_REFRESH_SECONDS=86400
HISTORICAL_RETRY_SECONDS=300
HISTORICAL_MAX_AGE_HOURS=48
HISTORICAL_PERIOD_HOURS=6
HISTORICAL_MIN_PROFITABLE_PERIODS=2
HISTORICAL_MAX_CONCENTRATION=0.8
# New candidate sources only: x5 = +400%, x10 = +900%. Other trades remain analyzed.
DISCOVERY_MIN_MULTIPLE=5
DISCOVERY_PRIORITY_MULTIPLE=10
DISCOVERY_SOURCE_TOKENS_PER_CYCLE=3
DISCOVERY_SOURCE_RETRY_SECONDS=300
# Explicitly suspend legacy bot.py + wallet_profiler.py; requires history + live paper.
RESEARCH_PAPER_ONLY=false
# Paper transport only; frozen portfolio policy and checkpoints are unchanged.
PAPER_LOG_QUERY_BLOCKS=10
PAPER_CATCHUP_WINDOW_BLOCKS=40
ARCSCAN_API_URL=https://api.arc-scan.org/v1
DEXSCREENER_CHAIN_ID=arc

POLL_INTERVAL_SECONDS=0.70
START_BLOCK=latest
MIN_USDC_FLOW=25
CLUSTER_WINDOW_SECONDS=1200
EXIT_CLUSTER_WINDOW_SECONDS=600

MIN_LIQUIDITY_USD=25000
MIN_MARKET_CAP_USD=50000
MAX_MARKET_CAP_USD=3000000
MAX_PAIR_AGE_HOURS=24
MAX_TOP10_CONCENTRATION_PCT=35
MIN_CLUSTER_WEIGHT=5
MIN_DISTINCT_WALLETS=2

LAUNCH_POLL_SECONDS=15
LAUNCH_CANDIDATE_RECHECK_SECONDS=60
LAUNCH_CANDIDATE_EXPIRE_HOURS=168
LAUNCH_MIN_LIQUIDITY_USD=1000
LAUNCH_CONTRACT_PAGE_SIZE=100
LAUNCH_TRANSFER_PAGE_SIZE=100
LAUNCH_MAX_MARKET_CHECKS_PER_CYCLE=40

WINNER_RETURN_PCT=100
SCANNER_CAPTURE_RATE=0.35
SCANNER_MIN_LAUNCH_BUYS=15
SCANNER_BUYS_PER_ACTIVE_HOUR=12
PROFILE_MIN_EVALUABLE_TRADES=5
PROFILE_REFRESH_SECONDS=60
INTELLIGENCE_RELOAD_SECONDS=30

# V4 automatic smart-wallet discovery
DISCOVERY_POLL_SECONDS=60
DISCOVERY_EARLY_BUYERS=50
DISCOVERY_TRANSFER_PAGES=20
DISCOVERY_ACTIVITY_PAGES=20
DISCOVERY_PAGE_SIZE=100
DISCOVERY_MAX_WALLETS_PER_CYCLE=10
DISCOVERY_QUARANTINE_HOURS=12

# Conservative promotion gates
PROMOTION_MIN_SCORE=68
PROMOTION_MIN_WINNERS=2
PROMOTION_MIN_LAUNCH_BUYS=8
PROMOTION_MAX_CAPTURE_RATE=0.25
PROMOTION_MAX_WALLETS=100
WATCHLIST_RELOAD_SECONDS=30

PAPER_NOTIONAL_USD=100
PAPER_STOP_LOSS_PCT=25
PAPER_TAKE_PROFIT_PCT=150

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO

# Cost controls: bounded log windows and reusable finalized RPC evidence.
SCANNER_LOG_WINDOW_BLOCKS=10
ARC_RPC_CACHE_ENABLED=true
ARC_RPC_CACHE_FILE=data/rpc_cache.sqlite3

# SQLite backup before supervisor startup, then hourly. No RPC calls.
AUTOMATIC_BACKUP_ENABLED=true
AUTOMATIC_BACKUP_DIRECTORY=data/automatic_backups
AUTOMATIC_BACKUP_INTERVAL_SECONDS=3600
AUTOMATIC_BACKUP_KEEP_LAST=24
AUTOMATIC_BACKUP_KEEP_DAILY=7
# Stop managed workers if backups keep failing past this age.
AUTOMATIC_BACKUP_MAX_AGE_SECONDS=10800
AUTOMATIC_BACKUP_TIMEOUT_SECONDS=300
AUTOMATIC_BACKUP_RESERVE_MB=2048

# Optional Alchemy Address Activity receiver; use the webhook signing key, not the RPC API key.
ALCHEMY_WEBHOOK_ENABLED=false
# Opt-in forward paper cohort. Preserves the previous checkpoint and all funds.
# Initial activation refuses open copied positions or pending orders.
PAPER_LIVE_ENABLED=false
ALCHEMY_WEBHOOK_HOST=127.0.0.1
ALCHEMY_WEBHOOK_PORT=8000
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_NOTIFY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_WEBHOOK_EXPECTED_URL=
ALCHEMY_SYNC_ENABLED=false
ALCHEMY_SYNC_SECONDS=300

# Follow-up audit: operational collection and data quality (not score thresholds)
LAUNCH_DISCOVERY_PAGES=10
OUTCOME_HORIZON_SECONDS=86400
OUTCOME_GRACE_SECONDS=300
IDENTITY_CACHE_SECONDS=3600
IDENTITY_WORKERS=4
TRUSTED_DEX_REGISTRY=trusted_dex.json

# Explicit paper assumptions, not measured venue execution costs
PAPER_FEE_BPS=30
PAPER_SLIPPAGE_BPS=50
PAPER_LIQUIDITY_FRACTION=0.001
PAPER_VOLUME_FRACTION=0.01

# Descriptive sizing/reporting only; no effect on promotion or signal authority
SIZING_MEDIUM_BUYS=5
SIZING_HIGH_BUYS=10
SIZING_CONCENTRATION_THRESHOLD=0.8
